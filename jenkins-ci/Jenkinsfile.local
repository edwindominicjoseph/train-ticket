pipeline {
    agent {
        kubernetes {
            cloud 'local-kind'
            defaultContainer 'jnlp'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: maven
      image: maven:3.9.9-eclipse-temurin-8
      command: [cat]
      tty: true
    - name: python
      image: python:3.12-bookworm
      command: [cat]
      tty: true
    - name: buildctl
      image: moby/buildkit:v0.25.1-rootless
      command: [sh, -c]
      args: [cat]
      tty: true
    - name: kubectl
      image: alpine/k8s:1.36.1
      command: [sh, -c]
      args: [cat]
      tty: true
    - name: curl
      image: curlimages/curl:8.16.0
      command: [sh, -c]
      args: [cat]
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
    - name: git
      image: alpine/git:2.49.1
      command: [sh, -c]
      args: [cat]
      tty: true
'''
        }
    }

    environment {
        REGISTRY = 'registry.registry.svc.cluster.local:5000'
        BUILDKIT_HOST = 'tcp://buildkitd.buildkit.svc.cluster.local:1234'
        TEST_NAMESPACE = 'train-ticket-test'
    }

    stages {
        stage('Identify artifact') {
            steps {
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.TRAVEL_IMAGE = "${env.REGISTRY}/ts-travel-service:${env.GIT_SHA}"
                    env.ROUTE_IMAGE = "${env.REGISTRY}/ts-route-service:${env.GIT_SHA}"
                }
            }
        }
        stage('Policy checks') {
            steps {
                container('python') {
                    sh 'git config --global --add safe.directory "$WORKSPACE"'
                    sh 'python3 script/check-secrets.py'
                    sh 'python3 -m unittest discover -s script/tests -p "test_*.py"'
                    sh 'bash -n hack/deploy/*.sh deployment/local-test/*.sh deployment/local-platform/*.sh'
                    sh 'bash script/tests/test-gen-mysql-secret.sh'
                }
            }
        }
        stage('Build and unit test') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'travel-jwt-test', variable: 'JWT_SECRET')]) {
                        sh 'mvn --batch-mode -pl ts-travel-service,ts-route-service -am clean verify'
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }
        stage('Rootless image build') {
            steps {
                container('buildctl') {
                    sh '''
                      buildctl --addr "$BUILDKIT_HOST" build \
                        --frontend dockerfile.v0 \
                        --local context=ts-travel-service \
                        --local dockerfile=ts-travel-service \
                        --opt filename=Dockerfile \
                        --output "type=image,name=$TRAVEL_IMAGE,push=true" \
                        --metadata-file travel-image-metadata.json
                      buildctl --addr "$BUILDKIT_HOST" build \
                        --frontend dockerfile.v0 \
                        --local context=ts-route-service \
                        --local dockerfile=ts-route-service \
                        --opt filename=Dockerfile \
                        --output "type=image,name=$ROUTE_IMAGE,push=true" \
                        --metadata-file route-image-metadata.json
                    '''
                }
                container('python') {
                    script {
                        env.IMAGE_DIGEST = sh(
                            script: "python3 -c \"import json; print(json.load(open('travel-image-metadata.json'))['containerimage.digest'])\"",
                            returnStdout: true
                        ).trim()
                        env.ROUTE_IMAGE_DIGEST = sh(
                            script: "python3 -c \"import json; print(json.load(open('route-image-metadata.json'))['containerimage.digest'])\"",
                            returnStdout: true
                        ).trim()
                    }
                }
            }
        }
        stage('Deploy test') {
            steps {
                container('kubectl') {
                    sh '''kubectl set image --local -f deployment/local-test/travel.yaml \
                        ts-travel-service="$TRAVEL_IMAGE" -o yaml | \
                        kubectl apply -f -'''
                    sh '''kubectl set image --local -f deployment/local-test/route.yaml \
                        ts-route-service="$ROUTE_IMAGE" -o yaml | \
                        kubectl apply -f -'''
                    sh 'kubectl -n "$TEST_NAMESPACE" rollout status deployment/ts-travel-service --timeout=300s'
                    sh 'kubectl -n "$TEST_NAMESPACE" rollout status deployment/ts-route-service --timeout=300s'
                }
            }
        }
        stage('Test smoke checks') {
            steps {
                container('curl') {
                    sh 'curl --fail --silent --show-error --max-time 10 http://ts-travel-service.train-ticket-test.svc.cluster.local:12346/api/v1/travelservice/welcome'
                    sh 'curl --fail --silent --show-error --max-time 10 http://ts-travel-service.train-ticket-test.svc.cluster.local:12346/api/v1/travelservice/trips >/dev/null'
                    sh 'curl --fail --silent --show-error --max-time 10 http://ts-route-service.train-ticket-test.svc.cluster.local:11178/api/v1/routeservice/welcome'
                    sh 'curl --fail --silent --show-error --max-time 10 http://ts-route-service.train-ticket-test.svc.cluster.local:11178/api/v1/routeservice/routes >/dev/null'
                }
            }
        }
        stage('Test route integration') {
            steps {
                container('python') {
                    sh '''python3 - <<'PY'
import json
import urllib.parse
import urllib.request

travel_url = "http://ts-travel-service.train-ticket-test.svc.cluster.local:12346/api/v1/travelservice/routes/G1234"
with urllib.request.urlopen(travel_url, timeout=10) as response:
    payload = json.load(response)
if payload.get("status") != 1:
    raise SystemExit(f"travel route lookup failed: {payload}")

query = urllib.parse.urlencode({"serviceName": "ts-route-service"})
nacos_url = "http://nacos.default.svc.cluster.local:8848/nacos/v1/ns/instance/list?" + query
with urllib.request.urlopen(nacos_url, timeout=10) as response:
    instances = json.load(response).get("hosts", [])
healthy = [instance for instance in instances if instance.get("healthy") and instance.get("port") == 11178]
if not healthy:
    raise SystemExit(f"Nacos has no healthy ts-route-service instance on port 11178: {instances}")
PY'''
                }
            }
        }
        stage('Approve production') {
            when { branch 'master' }
            steps {
                input message: "Promote ${TRAVEL_IMAGE}@${IMAGE_DIGEST} to local production?", ok: 'Promote'
            }
        }
        stage('Update GitOps production') {
            when { branch 'master' }
            steps {
                container('python') {
                    sh 'python3 script/promote-image.py --digest "$IMAGE_DIGEST" deployment/gitops/prod/kustomization.yaml'
                }
                container('git') {
                    withCredentials([usernamePassword(credentialsId: 'github-train-ticket', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                        sh '''
                          git config --global --add safe.directory "$WORKSPACE"
                          git config user.name "Jenkins GitOps"
                          git config user.email "jenkins-gitops@local.invalid"
                          git add deployment/gitops/prod/kustomization.yaml
                          git commit -m "chore(gitops): promote travel $GIT_SHA [skip ci]"
                          git push "https://$GITHUB_USER:$GITHUB_TOKEN@github.com/edwindominicjoseph/train-ticket.git" HEAD:master
                        '''
                    }
                }
            }
        }
    }
    post {
        failure {
            container('kubectl') {
                sh 'kubectl -n "$TEST_NAMESPACE" get pods -o wide || true'
                sh 'kubectl -n "$TEST_NAMESPACE" logs deployment/ts-travel-service --tail=200 || true'
                sh 'kubectl -n "$TEST_NAMESPACE" logs deployment/ts-route-service --tail=200 || true'
                sh 'kubectl -n "$TEST_NAMESPACE" logs statefulset/ts-route-mysql --tail=200 || true'
                sh 'kubectl -n "$TEST_NAMESPACE" describe deployment/ts-route-service || true'
                sh 'kubectl -n "$TEST_NAMESPACE" describe statefulset/ts-route-mysql || true'
                sh 'kubectl -n "$TEST_NAMESPACE" get events --sort-by=.lastTimestamp || true'
            }
        }
    }
}
