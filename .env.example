# Image coordinates (non-secret)
IMG_REPO=codewisdom
IMG_TAG=replace-with-an-immutable-version

# Shared runtime secrets. Generate unique values; never copy these examples to production.
JWT_SECRET=replace-with-at-least-32-random-characters
EMAIL_PASSWORD=replace-with-email-provider-app-password
NACOS_DB_PASSWORD=replace-with-random-nacos-database-password
TS_MYSQL_PASSWORD=replace-with-random-application-database-password

# Per-service database credentials used when running services outside the Kubernetes generator.
# "ts" matches the current generated Kubernetes database user; use a dedicated user per
# service when the database provisioning model supports it.
ASSURANCE_MYSQL_USER=ts
ASSURANCE_MYSQL_PASSWORD=replace-me
AUTH_MYSQL_USER=ts
AUTH_MYSQL_PASSWORD=replace-me
CONFIG_MYSQL_USER=ts
CONFIG_MYSQL_PASSWORD=replace-me
CONSIGN_PRICE_MYSQL_USER=ts
CONSIGN_PRICE_MYSQL_PASSWORD=replace-me
CONSIGN_MYSQL_USER=ts
CONSIGN_MYSQL_PASSWORD=replace-me
CONTACTS_MYSQL_USER=ts
CONTACTS_MYSQL_PASSWORD=replace-me
DELIVERY_MYSQL_USER=ts
DELIVERY_MYSQL_PASSWORD=replace-me
FOOD_DELIVERY_MYSQL_USER=ts
FOOD_DELIVERY_MYSQL_PASSWORD=replace-me
FOOD_MYSQL_USER=ts
FOOD_MYSQL_PASSWORD=replace-me
INSIDE_PAYMENT_MYSQL_USER=ts
INSIDE_PAYMENT_MYSQL_PASSWORD=replace-me
NOTIFICATION_MYSQL_USER=ts
NOTIFICATION_MYSQL_PASSWORD=replace-me
ORDER_OTHER_MYSQL_USER=ts
ORDER_OTHER_MYSQL_PASSWORD=replace-me
ORDER_MYSQL_USER=ts
ORDER_MYSQL_PASSWORD=replace-me
PAYMENT_MYSQL_USER=ts
PAYMENT_MYSQL_PASSWORD=replace-me
PRICE_MYSQL_USER=ts
PRICE_MYSQL_PASSWORD=replace-me
ROUTE_MYSQL_USER=ts
ROUTE_MYSQL_PASSWORD=replace-me
SECURITY_MYSQL_USER=ts
SECURITY_MYSQL_PASSWORD=replace-me
STATION_FOOD_MYSQL_USER=ts
